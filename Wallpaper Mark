name: Build Wallpaper Studio

on:
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Baixar projeto
        uses: actions/checkout@v4

      - name: Instalar Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Preparar Android SDK
        uses: android-actions/setup-android@v3
        with:
          packages: 'platform-tools platforms;android-36 build-tools;36.0.0'

      - name: Aceitar licencas Android
        run: yes | sdkmanager --licenses || true

      - name: Descompactar projeto
        run: |
          mkdir -p project
          unzip -o WallpaperStudio-v1.1-API36.zip -d project

      - name: Verificar projeto
        run: |
          find project -maxdepth 3 -type f | head -100

      - name: Instalar Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.11.1'

      - name: Compilar APK
        run: |
          cd project/WallpaperStudio-v1.1
          gradle assembleDebug --no-daemon

      - name: Guardar APK
        uses: actions/upload-artifact@v4
        with:
          name: WallpaperStudio-APK
          path: project/WallpaperStudio-v1.1/app/build/outputs/apk/debug/app-debug.apk
